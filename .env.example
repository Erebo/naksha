# NAKSHA Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# All settings read by Settings use the NAKSHA_ prefix.

# Application Environment (development, testing, production)
NAKSHA_ENVIRONMENT=development
NAKSHA_DEBUG=False

# Database Configuration
# Default: SQLite (works standalone without Docker)
NAKSHA_DATABASE_URL=sqlite:///naksha_spatial.db
# PostgreSQL + PostGIS (via Docker Compose):
# NAKSHA_DATABASE_URL=postgresql+psycopg://naksha_dev:naksha_dev_pw@localhost:5432/naksha
# Secondary Test Database (used for pytest postgres tests and alembic -x db=test):
NAKSHA_TEST_DATABASE_URL=postgresql+psycopg://naksha_dev:naksha_dev_pw@localhost:5432/naksha_test

# Docker Compose PostgreSQL Credentials (dev-only defaults)
POSTGRES_USER=naksha_dev
POSTGRES_PASSWORD=naksha_dev_pw
POSTGRES_DB=naksha
POSTGRES_PORT=5432

# Authentication & Security
# WARNING: Startup will fail in non-development environments if secret_key equals the default!
NAKSHA_SECRET_KEY=change-this-insecure-key-for-development-only
NAKSHA_JWT_ISSUER=naksha-auth-service
NAKSHA_JWT_EXPIRY_SECONDS=900

# Privacy & NID Salt / Key
# WARNING: Startup will fail in non-development environments if nid_hmac_secret equals the default!
NAKSHA_NID_HMAC_SECRET=dev-insecure-nid-salt-key-change-in-production

# CORS & Extension Allowed Origins
# To allow unpacked Chrome extension:
# 1. Open chrome://extensions, enable "Developer mode"
# 2. Copy the "ID" under NAKSHA extension card (e.g. "gohbkmchcbaidndchpkecofakfchdfik")
# 3. Add "chrome-extension://<id>" to the allowlist below
NAKSHA_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:3000","http://127.0.0.1:3000"]

# Authentication Rate Limiting
# For Playwright screenshot scripts (scripts/capture_screenshots.py), set MAX_REQUESTS higher (e.g. 100)
NAKSHA_AUTH_RATE_LIMIT_MAX_REQUESTS=5
NAKSHA_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Statutory Rule Thresholds
NAKSHA_KHAS_OVERLAP_LIMIT_DECIMALS=0.0
NAKSHA_AREA_TOLERANCE_DECIMALS=0.20
NAKSHA_OWNER_NAME_MATCH_THRESHOLD=0.80
NAKSHA_MAX_TAX_ARREARS_YEARS=1
NAKSHA_MAX_UNMUTATED_DAYS=30

# Statutory Legal References
NAKSHA_KHAS_ENCROACHMENT_LEGAL_REF=TODO: verify with legal source
NAKSHA_AREA_TOLERANCE_LEGAL_REF=TODO: verify with legal source
NAKSHA_OWNER_NAME_MATCH_LEGAL_REF=TODO: verify with legal source
NAKSHA_LD_TAX_COMPLIANCE_LEGAL_REF=TODO: verify with legal source
NAKSHA_MUTATION_STATUS_LEGAL_REF=TODO: verify with legal source
