# NAKSHA Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-insecure-key-for-development-only

# Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL / PostGIS)
DATABASE_URL=postgresql://naksha_user:naksha_password@localhost:5432/naksha_db

# Redis Configuration (Optional / Caching / Streams)
REDIS_URL=redis://localhost:6379/0

# Privacy & Security Keys
NID_SALT_SECRET=synthetic-salt-key-for-nid-hmac-hashing
LEDGER_ED25519_PRIVATE_KEY=
