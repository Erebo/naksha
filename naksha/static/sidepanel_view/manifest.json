{
  "manifest_version": 3,
  "name": "নকশা (NAKSHA) — ল্যান্ড ইন্টেলিজেন্স ও ২ডি জিআইএস সাইড প্যানেল",
  "short_name": "NAKSHA",
  "version": "1.0.0",
  "description": "আন্তঃসংস্থা ভূমি রেকর্ড যাচাইকরণ ও ইন্টারেক্টিভ ২ডি জিআইএস সাইড প্যানেল (ল্যান্ডটেক ২০২৬)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "নকশা (NAKSHA) সাইড প্যানেল খুলুন",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8000/portals/*",
        "http://localhost:8000/portals/*",
        "http://127.0.0.1:*/portals/*",
        "http://localhost:*/portals/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ]
}
